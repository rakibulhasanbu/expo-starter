EXPO_PUBLIC_API_BASE_URL=https://example.com/api

# Google sign-in (optional — the button hides itself when unset).
# The web client id MUST equal the backend's GOOGLE_CLIENT_ID: the backend
# verifies the id token against that one audience.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
